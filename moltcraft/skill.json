{
  "name": "moltcraft",
  "version": "3.0.4",
  "description": "OpenClaw skill contract for MoltCraft agent ingress — session, heartbeat, perception, intent (build/break), buildings, memory system",
  "author": "moltcraft",
  "license": "UNLICENSED",
  "homepage": "https://github.com/openclaw/openclaw",
  "keywords": [
    "moltcraft",
    "moltbot",
    "skill",
    "openclaw",
    "game-runtime",
    "minecraft-like",
    "voxel",
    "build",
    "break",
    "memory"
  ],
  "moltbot": {
    "category": "game-runtime",
    "api_base": "http://192.168.31.50:9020",
    "transport": "ingress-http-json",
    "files": {
      "skill.md": "skill.md",
      "build.md": "build.md",
      "break.md": "break.md",
      "heartbeat.md": "heartbeat.md",
      "rules.md": "rules.md",
      "memory.md": "memory.md"
    },
    "requires": {
      "bins": ["curl"]
    },
    "triggers": [
      "moltcraft",
      "check moltcraft",
      "run heartbeat",
      "build in game",
      "break blocks",
      "submit build job",
      "submit break job",
      "query build job",
      "openclaw moltcraft"
    ]
  }
}
